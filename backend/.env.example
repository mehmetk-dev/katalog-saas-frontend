# -----------------------------------------------------------------------------
# BACKEND CONFIGURATION (.env)
# -----------------------------------------------------------------------------

# Server Port
PORT=4000

# Supabase Configuration
# [DİKKAT] Service Role Key gizli tutulmalıdır!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage Provider (e.g., cloudinary, local)
STORAGE_PROVIDER=cloudinary
NEXT_PUBLIC_STORAGE_PROVIDER=cloudinary

# Cloudinary Configuration
# Ürün görsellerinin yönetimi ve silinenlerin arşivlenmesi için gereklidir.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_DELETED_FOLDER=deletedproducts

# SMTP Configuration (Zoho Mail)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=your_zoho_email
SMTP_PASS=your_zoho_app_password
SMTP_FROM=FogCatalog <your_zoho_email>

# Optional Redis Caching / PDF Export Queue
# REDIS_URL=redis://localhost:6379

# Server-side PDF export
PDF_EXPORT_RENDER_ORIGIN=http://localhost:3000
# Required in production when the backend is behind an internal proxy/service hostname.
PUBLIC_API_URL=http://localhost:4000/api/v1
WORKER_EXPORT_SECRET=replace-with-a-long-random-secret
PDF_EXPORT_WORKER_CONCURRENCY=1
PDF_EXPORT_CLEANUP_INTERVAL_MS=3600000

# Payment receipt PDF renderer (runs in the same worker service)
# BILLING_DOCUMENT_RENDER_ORIGIN=http://localhost:3000
BILLING_DOCUMENT_WORKER_CONCURRENCY=1

# Garanti BBVA hosted Sanal POS (backend-only)
# Keep disabled until the bank confirms the hosted 3D_OOS_PAY model and credentials.
GARANTI_POS_ENABLED=false
GARANTI_POS_MODE=TEST
GARANTI_POS_API_VERSION=512
GARANTI_POS_MERCHANT_ID=your_merchant_id
GARANTI_POS_TERMINAL_ID=your_8_digit_terminal_id
GARANTI_POS_TERMINAL_USER_ID=your_terminal_user_id
GARANTI_POS_PROV_USER_ID=PROVOOS
GARANTI_POS_PROVISION_PASSWORD=your_provision_password
GARANTI_POS_STORE_KEY=your_3d_store_key
GARANTI_POS_SECURITY_LEVEL=3D_OOS_PAY
GARANTI_POS_PAYMENT_URL=https://sanalposprovtest.garantibbva.com.tr/servlet/gt3dengine
GARANTI_POS_CALLBACK_URL=https://api.example.com/api/v1/billing/payments/garanti/callback
GARANTI_POS_RESULT_URL=https://example.com/checkout/result
GARANTI_POS_COMPANY_NAME=FogCatalog

# Server-to-server order inquiry, reconciliation, void and refund worker.
# Enable only after TEST verification. PROD URL must not contain "test".
GARANTI_OPERATIONS_ENABLED=false
GARANTI_POS_VP_URL=https://sanalposprovtest.garantibbva.com.tr/VPServlet
GARANTI_VP_USER_ID=your_terminal_user_id
GARANTI_VP_TIMEOUT_MS=10000
GARANTI_VP_MAX_RESPONSE_BYTES=131072
GARANTI_INQUIRY_PROV_USER_ID=PROVAUT
GARANTI_INQUIRY_PROVISION_PASSWORD=your_provaut_password
GARANTI_REFUND_PROV_USER_ID=PROVRFN
GARANTI_REFUND_PROVISION_PASSWORD=your_provrfn_password
GARANTI_RECONCILIATION_SCAN_INTERVAL_MS=30000
GARANTI_PAYMENT_WORKER_CONCURRENCY=1

# Legal merchant identity copied into immutable payment-receipt snapshots
BILLING_MERCHANT_LEGAL_NAME=
BILLING_MERCHANT_TAX_NUMBER=
BILLING_MERCHANT_TAX_OFFICE=
BILLING_MERCHANT_ADDRESS=
BILLING_MERCHANT_PHONE=
BILLING_MERCHANT_SUPPORT_EMAIL=
BILLING_MERCHANT_WEBSITE=

# Cloudflare R2 (S3-compatible) storage for PDF exports
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=fogcatalog-pdf-exports
# Optional - defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# R2_ENDPOINT=
# Optional - object key prefix inside the bucket
# R2_PDF_EXPORT_PREFIX=pdf-exports
# Optional - defaults to billing-documents
# R2_BILLING_DOCUMENT_PREFIX=billing-documents

# Monitoring
# SENTRY_DSN=your_sentry_dsn
